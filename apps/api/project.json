{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [
    "type:app",
    "scope:api"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew bootJar",
        "cwd": "apps/api"
      },
      "outputs": [
        "{projectRoot}/build/libs"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew bootRun",
        "cwd": "apps/api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew test",
        "cwd": "apps/api"
      }
    }
  }
}